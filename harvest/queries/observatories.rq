# Observatories with a location, still operating, with more than three Wikipedia articles about
# them -- the filter that turns 3 518 rows into the ~150 a beginner should see (docs/data-sources.md
# §8). `coord` arrives as WKT `Point(lon lat)`. Everything Wikidata is CC0.
SELECT ?item ?itemLabel ?coord ?countryLabel ?inception ?website WHERE {
  ?item wdt:P31/wdt:P279* wd:Q62832 ; wdt:P625 ?coord .
  MINUS { ?item wdt:P576 ?dissolved }
  ?item wikibase:sitelinks ?sl . FILTER(?sl > 3)
  OPTIONAL { ?item wdt:P17 ?country }
  OPTIONAL { ?item wdt:P571 ?inception }
  OPTIONAL { ?item wdt:P856 ?website }
  SERVICE wikibase:label { bd:serviceParam wikibase:language "en". }
}
